# ⚠️ Reemplazar con la URL real de tu base de datos de testing.
# Usar variables de entorno del CI (GitHub Secrets / Render env vars),
# NUNCA hardcodear credenciales en este archivo.
TEST_DATABASE_URL=postgresql://usuario:password@host:5432/neondb?sslmode=require

# httpx TestClient corre sobre HTTP; Secure=True impediría el envío de cookies
COOKIE_SECURE=false

# Facturación electrónica (Fase 4B) — guarani.app (sin configurar aún)
GUARANI_APP_API_KEY=
GUARANI_APP_PUNTO_EMISION=
GUARANI_APP_BASE_URL=https://api.guarani.app/v1