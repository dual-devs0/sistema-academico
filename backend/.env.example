# Base de datos. En desarrollo local se usa SQLite; en producción, PostgreSQL.
# Desde la migración Neon → Supabase (ver docs/web-system/MIGRACION_NEON_A_SUPABASE.md),
# el target de producción es el POOLER TRANSACTION de Supabase (puerto 6543),
# con sslmode=require obligatorio y IP allowlist en 0.0.0.0/0 (Render tiene IP dinámica).
# Rellená <SUPABASE_REF>, <PASSWORD> y <REGION> con los valores de tu proyecto.
# Local (dev):
DATABASE_URL=sqlite:///./sistema_academico.db
# Producción (Supabase pooler — reemplazar <...>):
# DATABASE_URL=postgresql+psycopg2://postgres.<SUPABASE_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

JWT_SECRET=cambiar-por-un-valor-seguro-de-32-chars
JWT_EXPIRES_MINUTES=480

# Cookies de refresh/csrf con flag Secure (requiere HTTPS). Default true.
# Bajar a false SOLO en dev local sobre http://localhost — nunca en producción.
COOKIE_SECURE=true

# Protección CSRF global (double-submit cookie) en todo POST/PUT/PATCH/DELETE
# mutante, excepto /auth/login, /auth/registro, /auth/recuperar-contrasena,
# /auth/reset-password, /auth/refresh y /static. Default true.
# CSRF_ENABLED=false DESACTIVA LA PROTECCIÓN CSRF COMPLETA para todos esos
# endpoints. No poner en false en producción salvo causa justificada y
# documentada aparte (ver AUDITORIA_2026-07-24.md hallazgo #3 — este flag
# antes leía por error RATE_LIMIT_ENABLED, ya corregido).
CSRF_ENABLED=true

# Rate limiting GLOBAL por IP + usuario + API key (app/rate_limiting.py,
# sliding window log, reemplaza al viejo slowapi). Default true — exige que
# todo request pase por los buckets (categorías con límites configurables
# abajo). Independiente de CSRF_ENABLED (son dos protecciones separadas).
# En tests se fuerza false (conftest.py).
RATE_LIMIT_ENABLED=true

# Buckets extra por API key (header X-API-Key). CSV de keys separadas por coma.
API_KEYS=

# Almacenamiento del rate limiter: si REDIS_URL está configurado usa Redis
# (compartido entre instancias); si no, o si Redis no responde, degrada
# automáticamente a memoria local del proceso (log warning una vez).
REDIS_URL=
REDIS_TOKEN=

# Rutas EXACTAS y PREFIJOS eximidos del rate limit (CSV). Defaults sensatos:
# healthcheck/version/metricas y swagger/static nunca deben bloquearse.
RATE_LIMIT_EXCLUDE_PATHS=/health,/version,/metrics,/
RATE_LIMIT_EXCLUDE_PREFIXES=/static,/docs,/openapi.json,/redoc

# Límites por categoría: formato "N" (N por ventana por defecto de la categoría)
# o "N/minutos" (ej. "6/10minutes"). Categories: AUTH, AUTH_LOGIN, AUTH_REGISTER,
# PASSWORD_RESET, VERIFY_EMAIL, UPLOADS, QR, REPORTS, EXPORTS, IMPORTS, SEARCH,
# HEAVY_ENDPOINTS, ADMIN, CRUD, PUBLIC_ENDPOINTS. GET general → RATE_LIMIT_DEFAULT_READ,
# mutaciones → RATE_LIMIT_DEFAULT_WRITE.
# Ejemplos (comentados con los defaults):
RATE_LIMIT_AUTH_LOGIN=15/60
RATE_LIMIT_AUTH_REGISTER=6/60minutes
RATE_LIMIT_PASSWORD_RESET=6/15minutes
# RATE_LIMIT_DEFAULT_READ=120/60
# RATE_LIMIT_DEFAULT_WRITE=60/60

# Comma-separated list of allowed frontend origins.
# In production, replace with the real domain: https://sistema.uca.edu.py
CORS_ORIGINS=http://localhost:5173

# ── EMAIL REAL (Tarea 1: recuperación de contraseña con link) ────────────────
# Proveedor de email: auto | mock | resend | sendgrid | smtp
#   auto     → Resend si hay RESEND_API_KEY, si no SendGrid si hay SENDGRID_API_KEY,
#              si no SMTP si está configurado, si no mode MOCK (loggea el email, no envía).
#   mock     → solo logs (ideal dev/test).
# Default: auto. Nunca rompe el request: reintenta con backoff y degrada con gracia.
EMAIL_PROVIDER=auto
EMAIL_FROM=sistema@uca.edu.py
EMAIL_FROM_NAME=Sistema Académico UCA
EMAIL_MAX_ATTEMPTS=3

# Resend (recomendado) — https://resend.com
RESEND_API_KEY=
# SendGrid — https://sendgrid.com
SENDGRID_API_KEY=
# SMTP (opcional; ej. Gmail con App Password como abajo). Si SMTP_USER
# está vacío, el proveedor SMTP usa MAIL_USERNAME como fallback.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
SMTP_STARTTLS=True
SMTP_SSL_TLS=False

# Fuerza el proveedor mock (solo logs, no envía) aunque haya credenciales
EMAIL_MOCK=false

# Configuración de fastapi-mail para Notificaciones (legacy, se mantiene)
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_FROM=sistema@uca.edu.py
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# Vigencia del token de reset en minutos (default 60). El token se guarda
# SOLO hasheado (SHA-256) en la BD, es de un solo uso, expira, y al usarse
# revoca todas las sesiones (refresh tokens) del usuario.
RESET_TOKEN_EXPIRATION_MINUTES=60

# URL del frontend para el enlace de recuperación de contraseña
# (se envía en el email de reset-password)
FRONTEND_URL=https://sistema.uca.edu.py
RESET_PASSWORD_FRONTEND_URL=https://sistema.uca.edu.py/reset-password

# Stripe — Pagos Online
# Sin STRIPE_SECRET_KEY y STRIPE_WEBHOOK_SECRET, los pagos online responden 503.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Facturación electrónica (Fase 4B) — guarani.app
# Sin estas credenciales, la emisión de comprobantes degrada con gracia:
# el pago se registra igual y el comprobante queda en estado 'error',
# reintentable, sin bloquear al alumno.
GUARANI_APP_API_KEY=
GUARANI_APP_PUNTO_EMISION=
GUARANI_APP_BASE_URL=https://api.guarani.app/v1

# Web Push VAPID keys (se autogeneran si están vacías)
VAPID_PUBLIC_KEY=BP_placeholder
VAPID_PRIVATE_KEY=placeholder
VAPID_CLAIM_EMAIL=admin@uca.edu.py

# Cloudflare R2 (o cualquier storage S3-compatible) — fotos de perfil, apuntes,
# comprobantes, informes de pasantía. Sin esto, las subidas de archivo fallan.
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=uca-v2-storage
