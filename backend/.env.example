# Base de datos. En desarrollo local se usa SQLite; en producción, PostgreSQL.
# Desde la migración Neon → Supabase (ver docs/web-system/MIGRACION_NEON_A_SUPABASE.md),
# el target de producción es el POOLER TRANSACTION de Supabase (puerto 6543),
# con sslmode=require obligatorio y IP allowlist en 0.0.0.0/0 (Render tiene IP dinámica).
# Rellená <SUPABASE_REF>, <PASSWORD> y <REGION> con los valores de tu proyecto.
# Local (dev):
DATABASE_URL=sqlite:///./sistema_academico.db
# Producción (Supabase pooler — reemplazar <...>):
# DATABASE_URL=postgresql+psycopg2://postgres.<SUPABASE_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

JWT_SECRET=cambiar-por-un-valor-seguro-de-32-chars
JWT_EXPIRES_MINUTES=480

# Cookies de refresh/csrf con flag Secure (requiere HTTPS). Default true.
# Bajar a false SOLO en dev local sobre http://localhost — nunca en producción.
COOKIE_SECURE=true

# Protección CSRF global (double-submit cookie) en todo POST/PUT/PATCH/DELETE
# mutante, excepto /auth/login, /auth/registro, /auth/recuperar-contrasena,
# /auth/reset-password, /auth/refresh y /static. Default true.
# CSRF_ENABLED=false DESACTIVA LA PROTECCIÓN CSRF COMPLETA para todos esos
# endpoints. No poner en false en producción salvo causa justificada y
# documentada aparte (ver AUDITORIA_2026-07-24.md hallazgo #3 — este flag
# antes leía por error RATE_LIMIT_ENABLED, ya corregido).
CSRF_ENABLED=true

# Rate limiting global por IP (slowapi) — 100 req/min default + límites
# específicos por endpoint (login, refresh, registro, recuperar-contrasena).
# Independiente de CSRF_ENABLED (son dos protecciones separadas).
RATE_LIMIT_ENABLED=true

# Comma-separated list of allowed frontend origins.
# In production, replace with the real domain: https://sistema.uca.edu.py
CORS_ORIGINS=http://localhost:5173

# Configuración de fastapi-mail para Notificaciones
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_FROM=sistema@uca.edu.py
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# URL del frontend para el enlace de recuperación de contraseña
# (se envía en el email de reset-password)
RESET_PASSWORD_FRONTEND_URL=https://sistema.uca.edu.py/reset-password

# Stripe — Pagos Online
# Sin STRIPE_SECRET_KEY y STRIPE_WEBHOOK_SECRET, los pagos online responden 503.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Facturación electrónica (Fase 4B) — guarani.app
# Sin estas credenciales, la emisión de comprobantes degrada con gracia:
# el pago se registra igual y el comprobante queda en estado 'error',
# reintentable, sin bloquear al alumno.
GUARANI_APP_API_KEY=
GUARANI_APP_PUNTO_EMISION=
GUARANI_APP_BASE_URL=https://api.guarani.app/v1

# Web Push VAPID keys (se autogeneran si están vacías)
VAPID_PUBLIC_KEY=BP_placeholder
VAPID_PRIVATE_KEY=placeholder
VAPID_CLAIM_EMAIL=admin@uca.edu.py

# Cloudflare R2 (o cualquier storage S3-compatible) — fotos de perfil, apuntes,
# comprobantes, informes de pasantía. Sin esto, las subidas de archivo fallan.
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=uca-v2-storage
