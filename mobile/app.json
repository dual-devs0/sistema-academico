{
  "expo": {
    "name": "UCA Móvil",
    "slug": "uca-movil",
    "owner": "cabrvix",
    "extra": {
      "apiBase": "http://192.168.100.12:8000",
      "router": {},
      "eas": {
        "projectId": "8099d7e4-3d70-4edf-82b4-d0c2ff73e6fd"
      },
      "updates": {
        "enabled": true,
        "checkAutomatically": "ON_LOAD"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/8099d7e4-3d70-4edf-82b4-d0c2ff73e6fd",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ucamovil",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "py.edu.uca.movil",
      "infoPlist": {
        "NSCameraUsageDescription": "Se requiere la cámara para escanear el código QR de asistencia.",
        "NSFaceIDUsageDescription": "Se usa Face ID para autenticación biométrica."
      }
    },
    "android": {
      "package": "py.edu.uca.movil",
      "adaptiveIcon": {
        "backgroundColor": "#1a3569",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "Se requiere la cámara para escanear el código QR de asistencia."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Se usa Face ID para autenticación biométrica."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#083D74",
          "image": "./assets/splash-transparent.png",
          "resizeMode": "contain"
        }
      ],
      "expo-video",
      "expo-status-bar",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
